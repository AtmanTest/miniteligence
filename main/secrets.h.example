#ifndef SECRETS_H
#define SECRETS_H

/* Copier ce fichier en secrets.h (ignore par git) et remplir les valeurs.
   secrets.h n'est jamais versionne : il contient le mot de passe Wi-Fi et les
   cles d'API. */

/* ---- Wi-Fi (obligatoire) ----
   2,4 GHz seulement : le S3 ne voit pas le 5 GHz. Sur un partage iPhone,
   activer "Maximiser la compatibilite". Les deux autres SSID sont des
   secours essayes dans l'ordre par le firmware. */
#define WIFI_SSID      "MON_RESEAU"
#define WIFI_SSID_ALT  "mon-reseau-2g"
#define WIFI_SSID_ALT2 "mon-reseau-bis"
#define WIFI_PASS      "MON_MOT_DE_PASSE"

/* ---- LLM ----
   Cle Groq : gratuite -> https://console.groq.com/keys
   Elle sert a la reconnaissance vocale ET au cerveau (LLM).
   Si elle est vide, le firmware bascule sur DeepSeek. */
#define GROQ_KEY ""

/* ---- DeepSeek ---- https://platform.deepseek.com/api_keys */
#define DEEPSEEK_KEY "sk-..."

#endif
